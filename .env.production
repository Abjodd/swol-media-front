# Used by `npm run build` (and by Vercel's build). Your Render API address — https, no trailing slash.
# It is not a secret: it ends up in the website's JavaScript, so this file is safe to commit.
# A VITE_API_URL set in Vercel → Settings → Environment Variables overrides this value.
VITE_API_URL=https://swol-media-back.onrender.com
